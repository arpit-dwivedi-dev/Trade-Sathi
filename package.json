{
  "name": "chartanalyzer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @chartanalyzer/web start",
    "dev:api": "pnpm --filter @chartanalyzer/api dev",
    "dev": "concurrently -n web,api \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "concurrently": "^9.0.1",
    "tsx": "^4.23.12"
  }
}
