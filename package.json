{
  "name": "chartanalyzer",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @chartanalyzer/web start",
    "dev:api": "pnpm --filter @chartanalyzer/api dev",
    "dev": "concurrently -n web,api \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
