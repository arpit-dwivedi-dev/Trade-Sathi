PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Use the Supabase session pooler host (IPv4) — the direct db.<ref>.supabase.co host is IPv6-only and unreachable without IPv6 routing; the session pooler (not the transaction pooler) supports the session-level features migrations need.
SUPABASE_DB_URL=
# Ordered AI provider fallback chain, as a JSON array on ONE line. The first
# entry is the primary; the rest are tried in order when it fails (outage,
# timeout, rate limit, rejected key, unusable response), so a provider going
# down costs the user seconds instead of a failed analysis.
#
# Every provider must support the OpenAI-compatible Chat Completions shape used
# here; provider-specific request differences must not be introduced unless a
# future provider actually requires them.
#
# Per-entry fields:
#   name            label used in logs to say which provider served a call
#   baseUrl/apiKey  the OpenAI-compatible endpoint and its key
#   model           model id at that provider
#   inputCostPerM   USD per million input tokens, used only to compute cost_usd
#   outputCostPerM  USD per million output tokens
#   maxTokens       completion token budget. Must be generous for a reasoning
#                   model, whose hidden reasoning is spent from this same
#                   budget before any visible content; lower it for a
#                   non-reasoning model.
#   supportsVision  optional, defaults to true. Set false for a text-only model
#                   (e.g. deepseek-chat): the uploaded-screenshot path skips it
#                   instead of spending a doomed request, while the
#                   candle-series path still uses it.
#
# Example:
# Providers are tried in this order. Several vision entries on the same key is
# deliberate, not redundancy for its own sake: Gemini free-tier request quota
# is metered PER MODEL, so a second and third model give the visual path fresh
# daily buckets once the primary returns 429. Text-only providers must set
# supportsVision:false — the visual chain skips them, and the candle-series
# path (live runs, and the fallback when every vision model is exhausted)
# still uses them.
# inputCostPerM/outputCostPerM are per model and feed analyses.cost_usd; check
# them against the provider's current pricing rather than copying a sibling.
# AI_PROVIDERS=[{"name":"gemini","baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai/","apiKey":"","model":"gemini-3.5-flash","inputCostPerM":0.30,"outputCostPerM":2.50,"maxTokens":16000},{"name":"gemini-3.6-flash","baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai/","apiKey":"","model":"gemini-3.6-flash","inputCostPerM":0.30,"outputCostPerM":2.50,"maxTokens":16000},{"name":"deepseek","baseUrl":"https://api.deepseek.com/v1","apiKey":"","model":"deepseek-chat","inputCostPerM":0.28,"outputCostPerM":0.42,"maxTokens":8000,"supportsVision":false}]
AI_PROVIDERS=
# Used only by scripts/test-analysis.ts (dev tool). A confirmed Supabase Auth
# user to sign in as when manually running a chart through the pipeline.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Market data comes from Yahoo Finance's unofficial chart API (no key/account
# needed) — see lib/market-data/yahoo-finance-provider.ts.
RESEND_API_KEY=
# e.g. "ChartAnalyzer <briefing@yourdomain.com>"
RESEND_FROM_ADDRESS=
# Shared secret required by the internal manual daily-briefing trigger route.
INTERNAL_OPS_TOKEN=
# Default hour of day (0-23), in IST, a watchlist symbol is analysed at. The
# scheduler now ticks hourly; this applies only to items with no per-item
# scheduled time of their own. Optional — defaults to 8 if unset.
DAILY_BRIEFING_RUN_HOUR_IST=
# Fundamentals verification middle layer (see
# services/fundamentals-verification.service.ts). Optional — defaults to
# true; set to "false" to bypass it entirely and feed the AI the raw
# provider payload, unchanged, exactly as before this layer existed.
FUNDAMENTALS_VERIFICATION_ENABLED=
# Base URL of a self-hosted SearXNG instance, used only as a pluggable
# search fallback for corroborating/correcting flagged fundamentals fields
# against authoritative sources. Optional — when unset, verification still
# runs its deterministic checks but marks every flagged field unverifiable
# instead of attempting a correction.
SEARXNG_BASE_URL=
